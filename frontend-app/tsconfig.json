{
	"compilerOptions": {
		"target": "ES2022",
		"module": "ESNext",
		"moduleResolution": "bundler",
		"verbatimModuleSyntax": true,
		"isolatedModules": true,
		"noEmit": true,
		"skipLibCheck": true,
		"strict": true,
		"allowJs": true,
		"checkJs": true,
		"types": ["svelte", "vite/client", "node"]
	},
	"include": ["src", "vite.config.ts", "prettier.config.js", "eslint.config.js"]
}
